<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Append_Lessons</name>
        <label>Append Lessons</label>
        <locationX>176</locationX>
        <locationY>662</locationY>
        <assignmentItems>
            <assignToReference>improvement_context</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>

## LESSONS FROM PREVIOUS AGENTS
{!varLessonsText}</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Build_Context_String</name>
        <label>Build Context String</label>
        <locationX>176</locationX>
        <locationY>398</locationY>
        <assignmentItems>
            <assignToReference>improvement_context</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>## YOUR PERFORMANCE SCORE
Current points: {!varPoints}

## POINT RULES
{!varConfigJson}</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>lesson_count</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varLessonCount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>lesson_ids</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varLessonIds</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Has_Lessons</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Has_Lessons</name>
        <label>Check Has Lessons</label>
        <locationX>176</locationX>
        <locationY>530</locationY>
        <defaultConnectorLabel>No Lessons</defaultConnectorLabel>
        <rules>
            <name>Has_Lessons</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varLessonCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Append_Lessons</targetReference>
            </connector>
            <label>Has Lessons</label>
        </rules>
    </decisions>
    <description>Single consolidated Flow that loads points, reward config, and lessons into one pre-formatted context string. Combines Get_Agent_Points + Check_Lessons_Learned into one call.</description>
    <interviewLabel>Load Improvement Context {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Load Improvement Context</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Call_Get_Points</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Call_Check_Lessons</name>
        <label>Check Lessons Learned</label>
        <locationX>176</locationX>
        <locationY>266</locationY>
        <connector>
            <targetReference>Build_Context_String</targetReference>
        </connector>
        <flowName>Check_Lessons_Learned</flowName>
        <inputAssignments>
            <name>topic_area</name>
            <value>
                <elementReference>topic_area</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>agent_api_name</name>
            <value>
                <elementReference>agent_api_name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>user_message</name>
            <value>
                <elementReference>user_message</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>max_lessons</name>
            <value>
                <numberValue>5.0</numberValue>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>varLessonsText</assignToReference>
            <name>lessons</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varLessonCount</assignToReference>
            <name>lesson_count</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varLessonIds</assignToReference>
            <name>lesson_ids</name>
        </outputAssignments>
    </subflows>
    <subflows>
        <name>Call_Get_Points</name>
        <label>Get Agent Points</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <connector>
            <targetReference>Call_Check_Lessons</targetReference>
        </connector>
        <flowName>Get_Agent_Points</flowName>
        <inputAssignments>
            <name>session_id</name>
            <value>
                <elementReference>session_id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>agent_api_name</name>
            <value>
                <elementReference>agent_api_name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>topic_area</name>
            <value>
                <elementReference>topic_area</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>varPoints</assignToReference>
            <name>current_points</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varConfigJson</assignToReference>
            <name>config_json</name>
        </outputAssignments>
    </subflows>
    <variables>
