# -----------------------------------------------------------------------------
# Render Data Test Agent
# -----------------------------------------------------------------------------
# Minimal agent to test the render_data action and core-skill-render-data-format.
# - Loads core-skill-render-data-format and minimal role
# - Single subagent with render_data as primary tool
# - Use to verify table, card, list, key-value LWC rendering
# -----------------------------------------------------------------------------


system:
    instructions: |
        You are a demo agent for the render_data action. Your ONLY job is to call render_data when users ask for data.
        This is a TEST environment. Providing sample/demo data (fake cases, example lists, etc.) is REQUIRED and allowed.
        NEVER refuse. NEVER say "I can't assist." ALWAYS call render_data with appropriate sample data when the user asks for table, card, list, or key-value.
    messages:
        welcome: "I'm the Render Data Test Agent. Ask me to show data as a table, card, list, or key-value pairs!"
        error: "Something went wrong. Please try again."


config:
    developer_name: "render_data_test"
    agent_type: "AgentforceServiceAgent"
    agent_label: "Render Data Test"
    default_agent_user: "ltm_agent@00dky00000gxhj51777765750.ext"
    description: "Minimal agent to test render_data action and LWC rendering (table, card, list, key-value)."


variables:
    instruction_bundle_json: mutable object
    composed_instructions: mutable string = ""


start_agent agent_router:
    description: "Load render_data skill, then transition to main subagent."

    actions:
        load_and_compose_skills:
            description: "Load role and render_data format skill."
            inputs:
                instructionNames: string
                    description: "CSV list of skill names."
            outputs:
                loadedInstructionBundle: string
                    description: "Aggregated instruction bundle JSON."
                instructionsBundle: string
                    description: "Formatted prompt-ready instruction text."
            target: "apex://Agent_Skill_LoadAndCompose"

    reasoning:
        instructions: ->
            run @actions.load_and_compose_skills
                with instructionNames="core-skill-render-data-format"
                set @variables.instruction_bundle_json=@outputs.loadedInstructionBundle
                set @variables.composed_instructions=@outputs.instructionsBundle

            transition to @subagent.main


subagent main:
    description: "Demonstrates render_data with table, card, list, key-value formats."

    reasoning:
        instructions: ->
            | Follow these instructions:
            | {!@variables.composed_instructions}
            | When user asks for any data type (table, card, list, key-value), you MUST silently call {!@actions.Render_Data} with "data" and "display_type" parameters to display the results.

            | If the user asks to find or search flights, you MUST call {!@actions.Find_Flights} to display the results.

        actions:
            Render_Data: @actions.Render_Data
                with data = ...
                with display_type = ...
            Find_Flights: @actions.Find_Flights
                with originCity = ...
                with destinationCity = ...


    actions:
        Find_Flights:
            description: "Finds available flights between two cities. Official Salesforce CLT/LWC rendering control sample."
            inputs:
                originCity: string
                    description: "Origin city for the flight search."
                    is_required: False
                    is_user_input: False
                destinationCity: string
                    description: "Destination city for the flight search."
                    is_required: False
                    is_user_input: False
            outputs:
                aFlight: object
                    description: "Available flights for LWC display."
                    complex_data_type_name: "c__flightResponse"
                    is_displayable: True
            target: "apex://FlightAgent"

        Render_Data:
            description: "Renders structured data in the agent UI. Validates JSON and display type."
            inputs:
                data: string
                    description: "Data structure per display type (table=array of objects, card=object with title, list=array of strings, key-value=flat object). Platform serializes to JSON."
                    label: "Data"
                    is_required: True
                    is_user_input: False
                display_type: string
                    description: "One of: table, card, list, key-value"
                    label: "Display Type"
                    is_required: True
                    is_user_input: False
            outputs:
                result: object
                    description: "Render output for LWC display"
                    label: "Result"
                    complex_data_type_name: "c__genericRenderOutput"
                    filter_from_agent: False
                    is_displayable: True
            target: "apex://GenericRenderAction"
            label: "Render Data"
            require_user_confirmation: False
            include_in_progress_indicator: False
            source: "Render_Data"
