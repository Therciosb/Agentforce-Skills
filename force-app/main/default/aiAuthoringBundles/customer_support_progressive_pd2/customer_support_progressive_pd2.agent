# -----------------------------------------------------------------------------
# Customer Support Progressive Disclosure Agent
# -----------------------------------------------------------------------------
# Architecture
# - start_agent (agent_router): hands off to skill_host on every turn.
# - skill_host (subagent): one host whose behavior comes from the active skills.
#   - Agent_Skill_State resolves this agent's skill wiring (by agent_name) and
#     returns skill_state: the skill menu, active skills, composed instructions
#     (always-on role/core skills + active skills), and loader warnings.
#   - The model calls switch_skills to change requested_skills. Instructions
#     re-resolve after the tool runs, and skills reload whenever
#     requested_skills differs from skill_state.active_skills.
#   - Optional LTM: loads Agent_Context__c for ContactId once per session. The
#     model records memory with update_memory; after_reasoning saves it.
#
# skill_state fields are read-only in Agent Script; only the Apex action writes
# the object. Its default must contain active_skills: reading a missing field
# makes the whole if condition evaluate false.
#
# Test contacts (myDevOrg) with Agent_Context__c memory. In messaging sessions
# ContactId is filled from MessagingContactId (@MessagingEndUser.ContactId).
# For preview, set ContactId in Builder's variables panel, or from the CLI:
#   sf agent preview start --authoring-bundle customer_support_progressive_pd2 \
#     --use-live-actions --context-variables 'ContactId=<Contact Id>'
# - Alexander Reed   003KY00000KNAGpYAP  iPhone 16 Pro vs Galaxy S25 Ultra comparison
# - Charles Davies   003KY00000KNAGrYAP  open case #7821, iPhone screen flicker
# - Sofia Rodriguez  003KY00000JwOLsYAN  order lookups, pending Galaxy S25 decision
# -----------------------------------------------------------------------------


system:
    instructions: |
        You are a customer support AI agent.
        Follow policy and safety constraints at all times.
        Do not invent product facts, case updates, or troubleshooting outcomes.
        Be concise. Respond in 2-4 sentences unless the user asks for detail.
    messages:
        welcome: "I'm Ready to Help!"
        error: "I am sorry, something went wrong. Please try again or ask for escalation to a human specialist."

model_config:
    model: "model://sfdc_ai__DefaultVertexAIGemini35Flash"


config:
    developer_name: "customer_support_progressive_pd2"
    agent_label: "Customer Support (Progressive Disclosure)"
    description: "Progressive disclosure through a single host subagent driven by an object-typed skill_state wired in the Skills app."


access:
    default_agent_user: "ltm_agent@00dky00000gxhj51777765750.ext"


variables:
    ContactId: mutable string = ""
    MessagingContactId: linked string
        source: @MessagingEndUser.ContactId
    EndUserId: linked string
        source: @MessagingSession.MessagingEndUserId
    RoutableId: linked string
        source: @MessagingSession.Id
    agent_name: mutable string = "customer_support_progressive_pd2"
        description: "Developer name used to look up this agent's skill wiring."
    skill_state: mutable object = {"active_skills": "unloaded"}
        description: "Skill menu, active skills, composed instructions, and warnings from Agent_Skill_State."
    requested_skills: mutable string = ""
        description: "CSV of skills the model asked for. A change triggers a reload."
    context_loaded: mutable boolean = False
    memory_dirty: mutable boolean = False
    agent_memory: mutable string = ""
    memory_summary: mutable string = ""
    memory_goal: mutable string = ""
    memory_has_issue: mutable boolean = False
    memory_style: mutable string = ""

start_agent agent_router:
    description: "Hand off to the skill host."

    reasoning:
        instructions: ->
            transition to @subagent.skill_host


subagent skill_host:
    label: "Skill Host"
    description: "Single host subagent. Behavior and tool use are driven by the active skills."

    actions:
        load_skill_state:
            description: "Resolve requested skills against this agent's wiring and return the skill state."
            inputs:
                agentName: string
                    description: "Developer name of the calling agent."
                subagentName: string
                    description: "Developer name of the calling subagent."
                requestedSkills: string
                    description: "CSV of skill names to activate."
            outputs:
                skillState: object
                    description: "Skill menu, active skills, composed instructions, and warnings."
                    complex_data_type_name: "@apexClassType/c__Agent_Skill_State$SkillState"
                    filter_from_agent: True
                activeSkills: string
                    description: "CSV of the skills actually activated."
                    filter_from_agent: True
            target: "apex://Agent_Skill_State"
        load_user_memory:
            description: "Load persistent memory for this contact (optional LTM)."
            inputs:
                contactId: string
                    description: "Contact identifier."
            outputs:
                agentMemory: string
                    description: "Formatted merge of memory fields for personalization."
                memorySummary: string
                    description: "Last conversation summary."
                memoryGoal: string
                    description: "Pending goal."
                hasIssue: boolean
                    description: "Unresolved issue flag."
                memoryStyle: string
                    description: "Communication style."
            target: "apex://LoadAgentMemory"
        save_context:
            description: "Persist an Agent_Context__c memory checkpoint (optional LTM)."
            inputs:
                contact_id: string
                    description: "Contact ID."
                new_summary: string
                    description: "Structured Markdown conversation summary."
                new_goal: string
                    description: "Pending goal or empty string."
                has_issue: boolean
                    description: "Unresolved issue flag."
                new_style: string
                    description: "Communication style: concise, detailed, or formal."
            outputs:
                success: boolean
                    description: "Whether save succeeded."
            target: "flow://Save_Agent_ContextObject"
        create_case:
            description: "Create a new support case from a concise subject line."
            inputs:
                subject: string
                    description: "Concise, user-approved case subject."
            outputs:
                case_number: string
                    description: "The created case number."
                error_message: string
                    description: "Why the case was not created, if it failed."
            target: "apex://CreateCase"
        create_escalation_ticket:
            description: "Create an escalation ticket for handoff to a human specialist."
            inputs:
                customer_id: string
                    description: "Contact/customer identifier."
                issue_description: string
                    description: "Summary of the unresolved issue."
                issue_type: string
                    description: "Escalation type (technical, billing, general)."
            outputs:
                ticket_id: string
                    description: "The created escalation ticket ID."
                error_message: string
                    description: "Why the ticket was not created, if it failed."
            target: "apex://CreateEscalationTicket"
        get_order_status:
            description: "Look up the current status of an order."
            inputs:
                order_id: string
                    description: "Order identifier."
            outputs:
                status: string
                    description: "Order status."
                tracking_number: string
                    description: "Shipment tracking number, if any."
                error_code: string
                    description: "Error code if order lookup fails or encounters an issue."
            target: "apex://GetOrderStatus"
        fetch_support_history:
            description: "Fetch the support/case history for a user."
            inputs:
                user_id: string
                    description: "User/contact identifier."
            target: "apex://FetchSupportHistory"
        track_shipment:
            description: "Track a shipment by carrier and tracking number."
            inputs:
                carrier: string
                    description: "Shipping carrier."
                tracking_number: string
                    description: "Tracking number."
            outputs:
                estimated_delivery: string
                    description: "Estimated delivery date."
                status: string
                    description: "Shipment status."
                success: boolean
                    description: "Whether tracking succeeded."
            target: "apex://TrackShipment"
        fetch_account_data:
            description: "Fetch account details for a user."
            inputs:
                user_id: string
                    description: "User/contact identifier."
            target: "apex://FetchAccountData"
        get_product_info:
            description: "Look up product specifications, price, and availability."
            inputs:
                product_name: string
                    description: "Product name to look up."
            outputs:
                in_stock: boolean
                    description: "Whether the product is in stock."
                price: object
                    description: "Product price."
                    complex_data_type_name: "lightning__currencyType"
                product_details: string
                    description: "Product specification details."
            target: "apex://GetProductInfo"
        send_verification_email:
            description: "Send a one-time verification code to the customer."
            inputs:
                customer_id: string
                    description: "Contact/customer identifier."
                email: string
                    description: "Destination email address."
            outputs:
                sent: boolean
                    description: "Whether the code was sent."
                token: string
                    description: "Verification token reference."
            target: "flow://SendVerificationEmail"

    reasoning:
        instructions: ->
            if @variables.ContactId == "" and @variables.MessagingContactId and @variables.MessagingContactId != "":
                set @variables.ContactId=@variables.MessagingContactId

            if @variables.context_loaded == False and @variables.ContactId and @variables.ContactId != "":
                run @actions.load_user_memory
                    with contactId=@variables.ContactId
                    set @variables.agent_memory=@outputs.agentMemory
                    set @variables.memory_summary=@outputs.memorySummary
                    set @variables.memory_goal=@outputs.memoryGoal
                    set @variables.memory_has_issue=@outputs.hasIssue
                    set @variables.memory_style=@outputs.memoryStyle
                set @variables.context_loaded=True

            if @variables.requested_skills != @variables.skill_state.active_skills:
                run @actions.load_skill_state
                    with agentName=@variables.agent_name
                    with subagentName="skill_host"
                    with requestedSkills=@variables.requested_skills
                    set @variables.skill_state=@outputs.skillState
                    set @variables.requested_skills=@outputs.activeSkills

            | Skills available to this agent:
            | {!@variables.skill_state.skill_menu}
            |
            | Active skills: {!@variables.skill_state.active_skills}
            | Before answering, check the request against the skills above. If it needs a skill that is not active, call {!@actions.switch_skills} with the complete CSV of skill names to use (no spaces after commas), then answer using the reloaded instructions. Keep a skill active while the conversation still needs it.
            |
            | agent_memory (empty if none):
            | {!@variables.agent_memory}
            |
            | Follow these instructions. They determine what to do and which tools to use:
            | {!@variables.skill_state.skill_instructions}

            if @variables.ContactId and @variables.ContactId != "":
                | Before your final answer on each turn, call {!@actions.update_memory} once to record the conversation so far. It is saved automatically.

        actions:
            switch_skills: @utils.setVariables
                description: "Change which skills are active for this request. Pass the complete CSV of skill names from the skill menu."
                with requested_skills=...
            update_memory: @utils.setVariables
                description: "Record long-term memory for this customer. Do not respond to the user in the same step."
                available when @variables.ContactId and @variables.ContactId != ""
                with memory_summary=...
                with memory_goal=...
                with memory_has_issue=...
                with memory_style=...
                with memory_dirty=True
            create_case: @actions.create_case
                description: "Create a new support case from a concise, user-approved subject."
                available when @variables.skill_state.tools.create_case == True
                with subject=...
            create_escalation_ticket: @actions.create_escalation_ticket
                description: "Create an escalation ticket for handoff to a human specialist. The customer ID is filled in automatically; never ask the customer for it."
                available when @variables.skill_state.tools.create_escalation_ticket == True and @variables.ContactId and @variables.ContactId != ""
                with customer_id=@variables.ContactId
                with issue_description=...
                with issue_type=...
            get_order_status: @actions.get_order_status
                description: "Look up the current status of an order."
                available when @variables.skill_state.tools.get_order_status == True
                with order_id=...
            fetch_support_history: @actions.fetch_support_history
                description: "Fetch the support/case history for the current customer."
                available when @variables.skill_state.tools.fetch_support_history == True and @variables.ContactId and @variables.ContactId != ""
                with user_id=@variables.ContactId
            track_shipment: @actions.track_shipment
                description: "Track a shipment by carrier and tracking number."
                available when @variables.skill_state.tools.track_shipment == True
                with carrier=...
                with tracking_number=...
            fetch_account_data: @actions.fetch_account_data
                description: "Fetch account details for the current customer."
                available when @variables.ContactId and @variables.ContactId != ""
                with user_id=@variables.ContactId
            get_product_info: @actions.get_product_info
                description: "Look up product specifications, price, and availability."
                available when @variables.skill_state.tools.get_product_info == True
                with product_name=...
            send_verification_email: @actions.send_verification_email
                description: "Send a one-time verification code to the current customer."
                available when @variables.skill_state.tools.send_verification_email == True and @variables.ContactId and @variables.ContactId != ""
                with customer_id=@variables.ContactId
                with email=...

    after_reasoning:
        if @variables.memory_dirty == True and @variables.ContactId and @variables.ContactId != "":
            run @actions.save_context
                with contact_id=@variables.ContactId
                with new_summary=@variables.memory_summary
                with new_goal=@variables.memory_goal
                with has_issue=@variables.memory_has_issue
                with new_style=@variables.memory_style
            set @variables.memory_dirty=False
